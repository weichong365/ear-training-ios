{
  "expo": {
    "name": "练耳搭子",
    "slug": "ear-training-buddy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-v1.png",
    "scheme": "lianerdazi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon-v1.png",
      "bundleIdentifier": "com.lianerdazi.app",
      "buildNumber": "41",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-v1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6F50",
          "image": "./assets/images/app-icon-v1.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ab03c07-dd4c-4257-a4ab-c971b604f91c"
      }
    }
  }
}
